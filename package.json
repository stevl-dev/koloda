{
  "name": "@koloda/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "apps/mobile/native",
    "libs/*"
  ],
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test:libs": "nx run-many --target=test --projects=tag:type:lib",
    "test:app-unit": "nx run @koloda/web:test-unit && nx run @koloda/electron:test:unit && nx run @koloda/mobile:test",
    "test:rust": "nx run koloda:test && nx run koloda-sync-proto:test && nx run koloda-server:test && nx run koloda-sync:test",
    "check:workspace-deps": "bunx vitest run --config tools/vitest.config.mjs --configLoader runner --exclude tools/docs.test.ts && bun run tools/check-workspace-deps.ts",
    "check:docs": "bunx vitest run --config tools/vitest.config.mjs --configLoader runner tools/docs.test.ts",
    "check:i18n": "bun run tools/check-i18n.ts",
    "lint": "oxlint --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "check:commit": "bun run lint && nx run koloda:lint",
    "check:format": "dprint check",
    "check:dead-code": "knip",
    "check:markdown": "bun run tools/check-markdown.ts",
    "check:push": "bun run tools/check-push.ts",
    "land": "bun run tools/land.ts",
    "check:rust": "nx run koloda:lint",
    "check:rust-deps": "bun run tools/check-rust-deps.ts",
    "check:rust-push": "bun run check:rust-deps && nx run koloda:lint && nx run koloda:test && nx run koloda-sync-proto:test && nx run koloda-server:test && nx run koloda-sync:test && nx run @koloda/electron:test-rust && nx run @koloda/mobile:test-rust",
    "check:ts": "bun run lint && bun run check:dead-code && bun run typecheck && bun run test:libs && bun run test:app-unit && bun run check:workspace-deps && bun run check:docs && bun run check:i18n",
    "check:web-all": "bun run check:ts && nx run web-e2e:e2e",
    "prepare": "git config core.hooksPath tools/hooks"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.58",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/provider-utils": "^5.0.53",
    "@dnd-kit/abstract": "^0.1.21",
    "@dnd-kit/react": "^0.1.21",
    "@fontsource-variable/inter": "^5.2.6",
    "@internationalized/date": "^3.12.1",
    "@lingui/core": "^5.6.0",
    "@lingui/detect-locale": "^5.6.0",
    "@lingui/react": "^5.6.0",
    "@number-flow/react": "^0.5.11",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@react-aria/focus": "^3.12.14",
    "@react-aria/i18n": "^3.12.14",
    "@react-aria/interactions": "^3.12.14",
    "@react-hook/media-query": "^1.1.1",
    "@react-types/shared": "^3.34.0",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/hotkeys": "^0.3.2",
    "@tanstack/react-form": "^1.25.0",
    "@tanstack/react-hotkeys": "^0.3.2",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-router": "^1.136.5",
    "@tanstack/react-table": "^9.0.0",
    "ai": "^7.0.126",
    "ai-sdk-ollama": "^4.4.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.16",
    "immer": "^10.2.0",
    "jotai": "^2.15.1",
    "marked": "^17.0.2",
    "motion": "^12.23.24",
    "ollama": "^0.6.4",
    "react": "19.3.0",
    "react-aria": "3.48.0",
    "react-aria-components": "^1.17.0",
    "react-dom": "19.3.0",
    "react-stately": "3.46.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1",
    "tailwindcss-react-aria-components": "^2.0.1",
    "ts-fsrs": "5.2.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "wa-sqlite": "^1.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@lingui/conf": "^5.6.0",
    "@lingui/format-po": "^5.6.0",
    "@lingui/swc-plugin": "^5.11.0",
    "@lingui/vite-plugin": "^5.6.0",
    "@nx/js": "23.3.0",
    "@nx/react": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@playwright/test": "^1.59.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.15.46",
    "@swc/helpers": "0.5.23",
    "@tanstack/router-plugin": "^1.136.5",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.4.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/ui": "4.1.9",
    "dprint": "0.58.0",
    "fake-indexeddb": "^6.2.5",
    "jiti": "2.4.2",
    "jsdom": "^30.1.1",
    "knip": "6.43.0",
    "nx": "23.3.0",
    "oxlint": "^1.75.0",
    "rolldown": "~1.2.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.9"
  }
}

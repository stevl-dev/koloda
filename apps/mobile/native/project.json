{
  "name": "@koloda/mobile-native",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/native/src",
  "projectType": "library",
  "tags": [
    "platform:mobile"
  ],
  "targets": {
    "bindings": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo build -p koloda-mobile",
          "bunx ubrn generate jsi bindings --library ../../../target/debug/libkoloda_mobile.so --ts-dir src/generated --cpp-dir cpp/generated",
          "bunx ubrn generate jsi turbo-module --config ubrn.config.yaml koloda_mobile"
        ],
        "parallel": false,
        "cwd": "apps/mobile/native"
      }
    },
    "build-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx ubrn build android --config ubrn.config.yaml --and-generate",
        "cwd": "apps/mobile/native"
      }
    }
  }
}

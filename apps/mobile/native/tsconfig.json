{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": [
      "esnext"
    ],
    "types": [],
    "customConditions": [
      "react-native"
    ],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}

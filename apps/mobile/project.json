{
  "name": "@koloda/mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "platform:mobile"
  ],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx expo start",
        "cwd": "apps/mobile"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx expo prebuild --platform android --no-install",
        "cwd": "apps/mobile"
      }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx expo run:android",
        "cwd": "apps/mobile"
      },
      "dependsOn": [
        {
          "projects": [
            "@koloda/mobile-native"
          ],
          "target": "build-android"
        }
      ]
    },
    "build-android": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prebuild",
        {
          "projects": [
            "@koloda/mobile-native"
          ],
          "target": "build-android"
        }
      ],
      "options": {
        "command": "./gradlew assembleDebug",
        "cwd": "apps/mobile/android"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/mobile --pretty false"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx jest",
        "cwd": "apps/mobile"
      },
      "cache": true
    },
    "lingui-extract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx lingui extract --clean",
        "cwd": "apps/mobile"
      }
    },
    "lingui-compile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx lingui compile",
        "cwd": "apps/mobile"
      }
    },
    "test-rust": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/clippy.toml",
        "{projectRoot}/src-rust/**/*",
        "{workspaceRoot}/crates/koloda/**/*",
        "{workspaceRoot}/crates/koloda-sync/**/*",
        "{workspaceRoot}/crates/koloda-sync-proto/**/*",
        "!{workspaceRoot}/crates/**/*.md"
      ],
      "options": {
        "command": "cargo test -p koloda-mobile",
        "forwardAllArgs": false,
        "env": {
          "CARGO_TARGET_DIR": "dist/target/koloda"
        }
      }
    }
  }
}

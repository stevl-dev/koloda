{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/spec",
    "tsBuildInfoFile": "dist/tsconfig.spec.tsbuildinfo",
    "jsx": "react-jsx",
    "module": "esnext",
    "types": [
      "node",
      "vite/client"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}

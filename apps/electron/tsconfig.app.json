{
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "preserve",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/assistant/tsconfig.lib.json"
    },
    {
      "path": "../../libs/srs/tsconfig.lib.json"
    },
    {
      "path": "../../libs/settings/tsconfig.lib.json"
    },
    {
      "path": "../../libs/app/tsconfig.lib.json"
    },
    {
      "path": "../../libs/native-ipc/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ai/tsconfig.lib.json"
    }
  ]
}

[
  {
    "rule": "headers",
    "cases": [
      {
        "name": "token names with values",
        "input": { "X-Api-Key": "key", "cf-aig-authorization": "Bearer token" },
        "expect": { "accepted": true }
      },
      { "name": "a null value keeps the stored one", "input": { "X-Api-Key": null }, "expect": { "accepted": true } },
      {
        "name": "every token punctuation mark in a name",
        "input": { "x!#$%&'*+-.^_`|~1": "value" },
        "expect": { "accepted": true }
      },
      { "name": "spaces inside a value", "input": { "Authorization": "Bearer abc" }, "expect": { "accepted": true } },
      {
        "name": "an empty name",
        "input": { "": "value" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "a space in a name",
        "input": { "X Api": "value" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "a colon in a name",
        "input": { "X-Api:": "value" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "a non-ASCII name",
        "input": { "Ключ": "value" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "names that differ only by case",
        "input": { "X-Api-Key": "a", "x-api-key": "b" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "an empty value",
        "input": { "X-Api-Key": "" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "a whitespace-only value",
        "input": { "X-Api-Key": "   " },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "a carriage return in a value",
        "input": { "X-Api-Key": "a\rb" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "a line feed in a value",
        "input": { "X-Api-Key": "a\nb" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      },
      {
        "name": "a NUL in a value",
        "input": { "X-Api-Key": "a\u0000b" },
        "expect": { "code": "validation.settings-ai.providers.headers" }
      }
    ]
  },
  {
    "rule": "model-ids",
    "cases": [
      { "name": "distinct IDs", "input": ["llama-3.1-8b", "qwen3-32b"], "expect": { "accepted": true } },
      { "name": "IDs that differ only by case", "input": ["Model-A", "model-a"], "expect": { "accepted": true } },
      { "name": "a space inside an ID", "input": ["my model"], "expect": { "accepted": true } },
      { "name": "an empty list", "input": [], "expect": { "accepted": true } },
      { "name": "an empty ID", "input": [""], "expect": { "code": "validation.settings-ai.providers.model-ids" } },
      {
        "name": "a leading space",
        "input": [" gpt-4o"],
        "expect": { "code": "validation.settings-ai.providers.model-ids" }
      },
      {
        "name": "a trailing space",
        "input": ["gpt-4o "],
        "expect": { "code": "validation.settings-ai.providers.model-ids" }
      },
      {
        "name": "a line feed inside an ID",
        "input": ["gpt\n4o"],
        "expect": { "code": "validation.settings-ai.providers.model-ids" }
      },
      {
        "name": "a NUL inside an ID",
        "input": ["gpt\u00004o"],
        "expect": { "code": "validation.settings-ai.providers.model-ids" }
      },
      {
        "name": "a repeated ID",
        "input": ["gpt-4o", "gpt-4o"],
        "expect": { "code": "validation.settings-ai.providers.model-ids" }
      },
      { "name": "a string instead of a list", "input": "gpt-4o", "expect": { "accepted": false } },
      { "name": "null", "input": null, "expect": { "accepted": false } }
    ]
  }
]

        "expect": {
          "accepted": true,
          "stored": {
            "defaults": {
              "algorithm": "01900000-0000-7000-8000-000000000001",
              "template": "01900000-0000-7000-8000-000000000002"
            },
            "dailyLimits": {
              "total": 200,
              "untouched": { "value": 50, "counts": true },
              "learn": { "value": null, "counts": false },
              "review": { "value": 200, "counts": true }
            },
            "dayStartsAt": "05:00",
            "learnAheadLimit": [0, 30]
          }
        }
      },

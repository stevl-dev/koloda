[
  {
    "rule": "defaults",
    "cases": [
      {
        "name": "empty daily limits",
        "input": {
          "defaults": {
            "algorithm": "01900000-0000-7000-8000-000000000001",
            "template": "01900000-0000-7000-8000-000000000002"
          },
          "dailyLimits": {}

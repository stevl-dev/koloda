[
  {
    "operation": "getTemplates",
    "cases": [
      { "name": "an empty database lists no templates", "expect": { "returns": [] } },
      {
        "name": "lists templates oldest first, each with its own lock",
        "seed": [
          { "add": "algorithm", "as": "fsrs" },
          { "add": "template", "as": "used", "title": "Used" },
          { "add": "template", "as": "unused", "title": "Unused" },
          { "add": "deck", "as": "deck", "algorithmId": "@fsrs", "templateId": "@used" },
          { "add": "card", "deckId": "@deck", "templateId": "@used" }
        ],
        "expect": {
          "returns": [
            { "id": "@used", "title": "Used", "isLocked": true },
            { "id": "@unused", "title": "Unused", "isLocked": false }
          ]
        }
      },
      {
        "name": "a deck without cards does not lock its template",
        "seed": [
          { "add": "algorithm", "as": "fsrs" },
          { "add": "template", "as": "basic" },
          { "add": "deck", "algorithmId": "@fsrs", "templateId": "@basic" }
        ],
        "expect": { "returns": [{ "id": "@basic", "isLocked": false }] }
      },
      {
        "name": "lists the stored content and notes",
        "seed": [{ "add": "template", "as": "basic", "title": "Basic", "createdAt": 1700000000000 }],
        "expect": {
          "returns": [
            {
              "id": "@basic",
              "title": "Basic",
              "notes": null,
              "createdAt": 1700000000000,
              "content": {
                "fields": [
                  {
                    "id": "01900000-0000-7000-8000-000000000001",
                    "title": "Front",
                    "type": "text",
                    "isRequired": true
                  },
                  {
                    "id": "01900000-0000-7000-8000-000000000002",
                    "title": "Back",
                    "type": "text",
                    "isRequired": false
                  }
                ],
                "layout": [
                  { "field": "01900000-0000-7000-8000-000000000001", "operation": "display" },
                  { "field": "01900000-0000-7000-8000-000000000002", "operation": "reveal" }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "a stored template outside today's rules lists on desktop and fails the read on web",
        "seed": [
          { "add": "template", "as": "valid" },
          { "add": "template", "as": "stored", "stored": { "title": "" } }
        ],
        "expect": {
          "ts": { "code": "db.get" },
          "rust": { "returns": [{ "id": "@valid" }, { "id": "@stored", "title": "" }] }
        },
        "divergence": "Web repos parse every stored entity row with the write-time Zod schema; desktop repos deserialize it without `validate()`"
      }
    ]
  },
  {
    "operation": "getTemplate",
    "cases": [
      {
        "name": "a template without cards is unlocked",
        "seed": [{ "add": "template", "as": "basic", "title": "Basic" }],
        "input": { "id": "@basic" },
        "expect": { "returns": { "id": "@basic", "title": "Basic", "isLocked": false } }
      },
      {
        "name": "a template with a card is locked",
        "seed": [
          { "add": "algorithm", "as": "fsrs" },
          { "add": "template", "as": "basic" },
          { "add": "deck", "as": "deck", "algorithmId": "@fsrs", "templateId": "@basic" },
          { "add": "card", "deckId": "@deck", "templateId": "@basic" }
        ],
        "input": { "id": "@basic" },
        "expect": { "returns": { "id": "@basic", "isLocked": true } }
      },
      {
        "name": "a card of another template does not lock this one",
        "seed": [
          { "add": "algorithm", "as": "fsrs" },
          { "add": "template", "as": "used" },
          { "add": "template", "as": "unused" },
          { "add": "deck", "as": "deck", "algorithmId": "@fsrs", "templateId": "@used" },
          { "add": "card", "deckId": "@deck", "templateId": "@used" }
        ],
        "input": { "id": "@unused" },
        "expect": { "returns": { "id": "@unused", "isLocked": false } }
      },
      {
        "name": "a missing id reads as null",
        "seed": [{ "add": "template" }],
        "input": { "id": "01900000-0000-7000-8000-0000000f423f" },
        "expect": { "returns": null }
      },
      {
        "name": "a stored template outside today's rules reads on desktop and fails the read on web",
        "seed": [{ "add": "template", "as": "stored", "stored": { "title": "" } }],
        "input": { "id": "@stored" },
        "expect": { "ts": { "code": "db.get" }, "rust": { "returns": { "id": "@stored", "title": "" } } },
        "divergence": "Web repos parse every stored entity row with the write-time Zod schema; desktop repos deserialize it without `validate()`"
      }
    ]
  }
]

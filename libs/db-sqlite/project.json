{
  "name": "@koloda/db-sqlite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "type:lib"
  ],
  "sourceRoot": "libs/db-sqlite/src",
  "projectType": "library",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.md",
      "sharedGlobals",
      "{workspaceRoot}/crates/koloda/src/migrations/*.sql",
      "{workspaceRoot}/crates/koloda/src/migrations/schema-inventory.json"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config libs/db-sqlite/vitest.config.mjs --configLoader runner"
      },
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    }
  }
}

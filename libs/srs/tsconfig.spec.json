{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/spec",
    "tsBuildInfoFile": "dist/tsconfig.spec.tsbuildinfo",
    "module": "esnext",
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.test.ts",
    "src/test-setup.ts",
    "src/test/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}

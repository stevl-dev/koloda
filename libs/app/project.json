{
  "name": "@koloda/app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "type:lib"
  ],
  "sourceRoot": "libs/app/src",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config libs/app/vitest.config.mjs --configLoader runner"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/crates/koloda/src/app/error.rs",
        "{workspaceRoot}/apps/electron/src-rust/src/sync.rs",
        "{workspaceRoot}/crates/koloda/src/domain/settings_interface.rs",
        "{workspaceRoot}/crates/koloda/src/domain/settings_hotkeys.rs",
        "{workspaceRoot}/crates/koloda/src/domain/seed_ids.rs",
        "{workspaceRoot}/libs/settings-react/public/theme-boot.js",
        "{workspaceRoot}/libs/ui/src/lib/styles/themes/*.css",
        "{workspaceRoot}/crates/koloda/tests/cases/*.json"
      ],
      "cache": true
    }
  }
}
